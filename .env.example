# Copie para .env (que não vai para o Git) e preencha.
# IA (resumo, título, nomes e destaques): Google Gemini. Chave em https://aistudio.google.com/apikey
# Plano pago: o Google não usa o texto enviado para melhorar produtos dele. Na camada gratuita usa; com uma chave
# gratuita, defina AVEIA_GEMINI_PLANO=gratuito para o aviso do app dizer isso.
GEMINI_API_KEY=

# Opcional. Padrão: gemini-3.1-flash-lite (alternativa: gemini-3.5-flash-lite)
# AVEIA_MODELO_GEMINI=gemini-3.1-flash-lite
# Opcional. minimal (padrão), low, medium ou high
# AVEIA_IA_RACIOCINIO=minimal
# Opcional. pago (padrão) ou gratuito: só muda o aviso de privacidade
# AVEIA_GEMINI_PLANO=pago
# Opcional. 0 desliga TODA a IA no servidor (padrão: ligada). O navegador tem o interruptor dele nos Ajustes.
# AVEIA_IA=1

# Reserva, usada só quando NÃO há GEMINI_API_KEY: Vercel AI Gateway (https://vercel.com/dashboard -> AI Gateway -> API Keys)
AI_GATEWAY_API_KEY=
